COMPOSE_PROJECT_NAME=film
REGISTRY_IMAGE_PREFIX=ghcr.io/fren4okolate/film-react-nest
IMAGE_TAG=review-2
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

NODE_ENV=production
PORT=3000
LOGGER_FORMAT=json
DATABASE_DRIVER=postgres
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=film_db
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=change-this-database-password
# DATABASE_URL=postgresql://database:5432/film_db

# Relative URLs use the same origin behind nginx.
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-pgadmin-password
PGADMIN_PORT=8080
