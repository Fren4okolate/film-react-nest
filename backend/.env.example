# PostgreSQL
DATABASE_DRIVER=postgres
# Можно указать URL вместо DATABASE_HOST, DATABASE_PORT и DATABASE_NAME.
# DATABASE_URL=postgresql://localhost:5432/film_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=film_pass
DATABASE_NAME=film_db
PORT=3000
NODE_ENV=development
# dev, json или tskv
LOGGER_FORMAT=dev
# Только для интеграционных тестов: отдельная тестовая база.
# TEST_DATABASE_URL=postgresql://film_test:film_test@localhost:5432/film_test
